@echo off
pwsh -NoProfile -Command "$e=@(); $p=Split-Path -Parent '%~dp0'; Set-Location $p; $f=git diff --cached --name-only 2>`$null; $pat=@('AKIA[0-9A-Z]{16}','-----BEGIN.*PRIVATE KEY-----','sk-[a-zA-Z0-9]{32,}','ghp_[a-zA-Z0-9]{36}','AIza[0-9A-Za-z_-]{35}'); foreach($x in $f){$c=gc $x -Raw -ErrorAction SilentlyContinue; if(-not$c){continue}; foreach($p in $pat){if($c-match$p){$e+='SECRET en '+$x}}}; if($f-contains'AGENTS.md'){$a=gc AGENTS.md -Raw; if($a-match'knowledge-vault'){$e+='AGENTS.md contiene knowledge-vault'}}; if($e.Count-gt0){Write-Host '=== PRE-COMMIT: ERRORES ===' -ForegroundColor Red; foreach($x in $e){Write-Host \"  [FAIL] $x\" -ForegroundColor Red}; Write-Host 'Commit abortado' -ForegroundColor Red; exit 1}; exit 0"
